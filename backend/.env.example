# Αντίγραψε αυτό το αρχείο σε .env και συμπλήρωσε πραγματικές τιμές.
# Το .env ΔΕΝ κάνει commit ποτέ (βλ. .gitignore) -- αυτό εδώ το κάνει,
# με placeholder τιμές μόνο.

# PostgreSQL connection string -- postgresql://user:pass@host:port/dbname
# (τοπικά matches το docker-compose.yml, σε production το δίνει η
# πλατφόρμα, π.χ. Railway Postgres plugin -- βλ. README.md)
DATABASE_URL=postgresql://kosovo_user:kosovo_pass@localhost:5432/kosovo_analytics

# Οποιοδήποτε τυχαίο, μεγάλο string -- υπογράφει τα JWT access tokens.
# Δημιούργησε ένα δικό σου, π.χ.: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-long-random-string

# Anthropic Claude API key (https://console.anthropic.com) -- χρειάζεται
# για Synthesis/Compare/per-event Q&A. Χωρίς αυτό, αυτά τα endpoints
# απαντούν με 502.
ANTHROPIC_API_KEY=sk-ant-api03-replace-with-your-key

# Production frontend origin για CORS (π.χ. https://<app>.up.railway.app).
# Άφησέ το κενό σε τοπικό dev -- το localhost regex στο main.py αρκεί.
FRONTEND_URL=

# Αρχικός ADMIN χρήστης που δημιουργεί το seed script (idempotent -- μόνο
# αν δεν υπάρχει ήδη ADMIN). Αν τα αφήσεις κενά, το seed script κάνει
# fallback σε dev-only default credentials (admin@local.dev/devonly123)
# με ρητό warning -- ΟΡΙΣΕ ΤΑ σε production deployment (βλ. README.md).
ADMIN_EMAIL=
ADMIN_PASSWORD=
